{
  "name": "mac-spotify-releases",
  "version": "1.0.0",
  "description": "macOS desktop app for tracking Spotify artist releases",
  "author": "Patrick Eakin",
  "main": "electron/main.js",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axios": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm start\" \"wait-on http://localhost:3001 && NUMU_DEV_PORT=3001 electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.numu.mac-spotify-releases-v2",
    "productName": "NUMU",
    "protocols": {
      "name": "NUMU OAuth",
      "schemes": [
        "numu"
      ]
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/main.js",
      "electron/preload.js"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "build-resources/icon-final.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "NUMU - Spotify Releases"
    }
  }
}
